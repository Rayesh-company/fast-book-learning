.env
.env.*
!.env.example
.venv/
__pycache__/
.pytest_cache/
*.pyc
ui/usage.sqlite3
ui/accounts.sqlite3
# The customer PDFs stay out of git; provision books/ from the
# cognee storage export (see ADR-0007). The text indexes ship.
books/*.pdf
# The page rasters' disk cache (ADR-0017) — regenerable by design.
render-cache/
# The offline build's planted wheels (ui/Dockerfile) — they ride the
# deploy tree, never git.
ui/wheels/*.whl
~$*
.agents/
.claude/
.zcode/
.playwright-mcp/
tests/reader/node_modules/
ui/narration/node_modules/
ui/narration/alignment/node_modules/
models/
.scratch/
*.dump
*.tar
*.tar.gz
*.zip

ui/usage_ledger.sqlite3
ui/audit.sqlite3
# The worktree's runtime stores — the deployed copies live on /data.
ui/research.sqlite3
ui/sessions.sqlite3

# The pilot bench Accounts (credentials) — local only, never committed.
benchmark/pilot/accounts.json
# The pilot's run outputs (per-run JSON/CSV, the reports) — data, not code.
benchmark/pilot/runs/

# Local-only compose overrides (native PG18 owns 5432 here).
compose.override.yaml

# The Expo mobile app's build artifacts (ADR-0020).
mobile/node_modules/
mobile/.expo/

# The OTA payload (rule 001): build output, regenerated by
# scripts/publish_ota.py — the publish + deploy carry it, never git.
ui/ota/current/
ui/ota/manifest.json

# The برنامک's binding store (ADR-0021) — the deployed copy lives on
# /data; the worktree's is runtime data, never git.
ui/eitaa.sqlite3
ui/notes.sqlite3
# The SMS login's waitlist (2026-10-23) — the deployed copy lives on
# /data; the worktree's is runtime data, never git.
ui/waitlist.sqlite3
# A built APK is a build artifact (rule 001: mobile ships OTA, never a
# new binary) — locally built for an emulator flavor, never committed.
mobile/*.apk
