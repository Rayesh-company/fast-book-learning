.env
.env.*
!.env.example
.venv/
__pycache__/
.pytest_cache/
*.pyc
ui/usage.sqlite3
ui/accounts.sqlite3
# The customer PDFs stay out of git; provision books/ from the
# cognee storage export (see ADR-0007). The text indexes ship.
books/*.pdf
books/**/*.mp3
books/**/lectures/
# The page rasters' disk cache (ADR-0017) — regenerable by design.
render-cache/
# The offline build's planted wheels (ui/Dockerfile) — they ride the
# deploy tree, never git.
ui/wheels/*.whl
~$*
.agents/
.claude/
.zcode/
.playwright-mcp/
tests/reader/node_modules/
ui/narration/node_modules/
ui/narration/alignment/node_modules/
models/
.scratch/
scratch/
chat-with-books-handoff/
fast-book-audio-delivery/
*.dump
*.tar
*.tar.gz
*.zip

ui/usage_ledger.sqlite3
ui/audit.sqlite3
# The worktree's runtime stores — the deployed copies live on /data.
ui/research.sqlite3
ui/sessions.sqlite3

# The pilot bench Accounts (credentials) — local only, never committed.
benchmark/pilot/accounts.json
# The pilot's run outputs (per-run JSON/CSV, the reports) — data, not code.
benchmark/pilot/runs/

# The Mastra chat agent service (ADR-0018)
agent/node_modules/
agent/.mastra/
agent/dist/
agent/src/mastra/public/data/

# Reticle browser-test artifacts
.reticle/

# Local e2e scratch
e2e-tmp/
agent-dev.log
